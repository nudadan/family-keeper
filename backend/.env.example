# Copy this file to ".env" and adjust the values.

# Port the HTTP server listens on
PORT=3000

# Shared secret. The Android tracker app must send this in the "X-API-Key" header
# when POSTing positions. Keep it long and random.
API_KEY=change-me-to-a-long-random-string

# Path to the SQLite database file (relative to the backend folder or absolute)
DB_PATH=./data/gtracker.db

# Admin site (/admin) credentials. Used for HTTP Basic auth.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Google Maps JavaScript API key used to render the map on the admin site.
# NOTE: this must be a key allowed for "Maps JavaScript API" with an HTTP
# referrer restriction (e.g. https://your-domain/*) — an Android-only key
# (restricted by package name + SHA-1) will NOT work here.
MAPS_API_KEY=

# WhatsHub (whatshub.noesantara.online) credentials used by the "Jemput"
# (pickup request) feature to send WhatsApp messages server-side. Never
# exposed to the Android app. Each group's target WhatsApp group ID is set
# separately in the admin site (Groups table), not here.
WHATSHUB_BASE_URL=https://whatshub.noesantara.online
WHATSHUB_APP_ID=
WHATSHUB_SECRET_KEY=
